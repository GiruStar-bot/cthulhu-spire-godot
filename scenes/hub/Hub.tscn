[node name="RuneCategoryRow" type="HFlowContainer" parent="Root/Body/Content/EquipmentPanel"]
layout_mode = 2

[node name="RuneScroll" type="ScrollContainer" parent="Root/Body/Content/EquipmentPanel"]
