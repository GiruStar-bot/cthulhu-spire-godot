## grimoire.ts の GRIMOIRE（モジュールトップレベル定数）相当。
## GDScriptにはトップレベルでの配列内包表記が無いため関数化して都度構築する
## （50件程度のためコスト上問題ない）。
static func chapters() -> Array:
	var out: Array = []
	for i in range(CHAPTER_TITLES.size()):
		var index := i + 1
		out.append({
			"index": index,
			"title": CHAPTER_TITLES[i],
			"body": BODIES.get(index, LOCKED),
			"card_id": CARDS[i] if i < CARDS.size() else null,
		})
	return out


## grimoire.ts の nextUnread()
static func next_unread(read: Array):
	for ch in chapters():
		if ch.card_id != null and not read.has(ch.card_id):
			return ch
	return null
